# Optional: stable /dev/monitor-orient symlink for the Pico sensor.
# The daemon already finds the board via its /dev/serial/by-id/... path, so this
# is only needed if you prefer a fixed device name. Adjust idVendor/idProduct to
# match your board (find them with: `lsusb` or `udevadm info -a -n /dev/ttyACM0`).
#
# Install:  sudo cp 99-monitor-orient.rules /etc/udev/rules.d/
#           sudo udevadm control --reload && sudo udevadm trigger
#
# Default MicroPython on a Pico enumerates as 2e8a:0005.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="0005", SYMLINK+="monitor-orient", MODE="0660"
